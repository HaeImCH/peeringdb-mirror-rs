name = "peeringdb-mirror"
main = "build/worker/shim.mjs"
compatibility_date = "2024-04-01"
compatibility_flags = ["nodejs_compat"]

[build]
# worker-build must match workers-rs (0.9.x). It is installed into the
# project-local .tools/ so it never replaces a global worker-build that other
# workers-rs projects on this machine depend on.
command = "cargo install -q --root .tools worker-build --version 0.9.0 --locked && .tools/bin/worker-build --release"

[triggers]
crons = ["0 */3 * * *"] # run sync every 3 hours

[observability.logs]
enabled = true
invocation_logs = true

[[d1_databases]]
binding = "PEERINGDB"
database_name = "peeringdb-mirror"
database_id = "YOUR_D1_DATABASE_ID" # run: wrangler d1 create peeringdb-mirror
